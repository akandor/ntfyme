    "Played for messages with priority High (4) or Max (5). Lower priorities use the sound chosen above." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird bei Nachrichten mit der Priorität „Hoch“ (4) oder „Max“ (5) abgespielt. Bei niedrigeren Prioritäten wird der oben ausgewählte Ton verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reproduce para los mensajes con prioridad Alta (4) o Máxima (5). Las prioridades inferiores usan el sonido elegido arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joué pour les messages de priorité Élevée (4) ou Maximale (5). Les priorités inférieures utilisent le son choisi ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprodotto per i messaggi con priorità Alta (4) o Massima (5). Le priorità inferiori usano il suono scelto sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高(4)または最大(5)優先度のメッセージで再生されます。それ以下の優先度では上記で選択したサウンドが使用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocado para mensagens com prioridade Alta (4) ou Máxima (5). Prioridades menores usam o som escolhido acima."
          }
        }
      }
