    "Add a topic in Settings to start receiving notifications.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge in den Einstellungen ein Thema hinzu, um Benachrichtigungen zu erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un sujet dans les Réglages pour commencer à recevoir des notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un tema en Ajustes para empezar a recibir notificaciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を受け取るには、設定でトピックを追加してください。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un argomento in Impostazioni per iniziare a ricevere notifiche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um tópico nas Configurações para começar a receber notificações."
          }
        }
      }
    },
