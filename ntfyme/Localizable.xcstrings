{
  "sourceLanguage" : "en",
  "strings" : {
    "·" : {

    },
    "\"System default\" follows the macOS notification sound and respects Do Not Disturb. Named sounds play directly and will be heard even while a Focus mode is active." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Systemstandard“ verwendet den Standard-Benachrichtigungston von macOS und berücksichtigt den Modus „Nicht stören“. Benannte Töne werden direkt abgespielt und sind auch dann zu hören, wenn der Fokusmodus aktiv ist."
          }
        }
      }
    },
    "A native macOS menu bar client for ntfy brought to you by Toepper.Rocks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein nativer macOS-Menüleisten-Client für ntfy, bereitgestellt von Toepper.Rocks."
          }
        }
      }
    },
