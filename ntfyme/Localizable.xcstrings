    "Shown next to messages from this topic in the popup and history. Choose “Automatic” to derive the look from message tags.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird neben Beiträgen zu diesem Thema im Popup-Fenster und im Verlauf angezeigt. Wähle „Automatisch“, um das Erscheinungsbild anhand der Beitrags-Tags anzupassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiché à côté des messages de ce sujet dans la fenêtre contextuelle et l'historique. Choisissez « Automatique » pour dériver l'apparence des étiquettes du message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra junto a los mensajes de este tema en la ventana emergente y el historial. Elige «Automático» para derivar el aspecto de las etiquetas del mensaje."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポップアップと履歴のこのトピックのメッセージの横に表示されます。「自動」を選択するとメッセージタグから外観が導き出されます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrato accanto ai messaggi di questo argomento nel popup e nella cronologia. Scegli «Automatico» per derivare l'aspetto dai tag del messaggio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrado ao lado das mensagens deste tópico no popup e no histórico. Escolha «Automático» para derivar a aparência das tags da mensagem."
          }
        }
      }
    },
